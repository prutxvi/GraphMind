# Sarvam AI LLM API Configuration
# Get your API key from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Backend Configuration (Optional)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=True

# CORS Configuration
# For production, replace "*" with specific domain: https://yourdomain.com
CORS_ORIGINS=*
