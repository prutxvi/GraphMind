# LLM: any OpenAI-compatible chat endpoint. Defaults to the opencode-go gateway with deepseek-v4-flash.
LLM_API_KEY=your_key_here
# LLM_BASE_URL=https://opencode.ai/zen/go/v1
# LLM_MODEL=deepseek-v4-flash

# Where filings and the database live (default: ../data)
# DATA_DIR=../data

# Set to 0 on a public deployment to serve only filings you have already read.
# ALLOW_UPLOADS=1

# Only needed when the frontend runs on a different origin than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits and thresholds
# MAX_UPLOAD_MB=60
# CHUNK_CHARS=9000
# EXTRACT_WORKERS=4       # parallel LLM calls; lower if you hit rate limits
# RPT_HIGH_PCT=10         # related-party business as % of revenue: strong flag
# RPT_MEDIUM_PCT=3        # ...and the softer one
