# LLM: any OpenAI-compatible chat endpoint. Defaults to Sarvam.
# Get a key from https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
# LLM_BASE_URL=https://api.sarvam.ai/v2
# LLM_MODEL=gemma4

# Comma-separated list of allowed browser origins. Not needed when the
# frontend is served by the backend itself (single-service deploy).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits
# MAX_UPLOAD_MB=20
# MAX_PAGES=150
# MAX_CHUNKS=40          # LLM calls per upload (~5,000 chars each)
# EXTRACT_WORKERS=4      # parallel LLM calls; lower this if you hit rate limits
# MAX_GRAPHS=50          # graphs kept in memory
# GRAPH_TTL_SECONDS=21600
